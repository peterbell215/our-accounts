<%# Append the next page of rows before the end-of-table marker, then replace the marker itself with one
    carrying the following cursor — or with a plain marker once the history runs out, which is what stops
    the scrolling. %>
<%= turbo_stream.before "end-of-table-marker" do %>
  <% @page.transactions.each do |transaction| %>
    <%= render "transactions/transaction_as_row",
               transaction: transaction, categories: @categories, account: @account %>
  <% end %>
<% end %>

<%= turbo_stream.replace "end-of-table-marker" do %>
  <%= render "transactions/pager", account: @account, page: @page %>
<% end %>
