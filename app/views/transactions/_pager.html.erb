<%# The end of the list.  Two jobs: it is the insertion point for newly created transactions (see
    TransactionsController#new and #create), and it carries the URL of the next page for the
    transactions_list controller to fetch when the reader reaches the bottom. %>
<div id="end-of-table-marker"
     class="div-table-row"
     data-next-url="<%= transactions_next_page_url(account, page) %>">
</div>
