<%# Use form_with for the entire row.  Takes transaction:, account: and categories: as locals — every
    caller passes them, including the Turbo Stream renders in TransactionsController. %>
<% url = transaction.persisted? ? account_transaction_path(account, transaction) : account_transactions_path(account) %>
<%= form_with model: [account, transaction],
              url: url, # Explicitly set the URL
              id: dom_id(transaction, transaction.persisted? ? nil : 'new'),
              html: { class: "div-table-row transaction-row" },
              data: { controller: "transaction-row",
                      action: "input->transaction-row#refresh change->transaction-row#refresh",
                      transaction_row_unsaved_value: !transaction.persisted?,
                      transaction_row_pending_value: transaction.counterparty_to_confirm.present?,
                      transaction_id: transaction.id} do |f| %>

  <%# Date Column - a date the reader can still edit needs the browser's own date field %>
  <div class="div-table-col">
    <% if transaction.persisted? %>
      <span><%= short_date(transaction.date) %></span>
    <% else %>
      <%= f.date_field :date, value: (transaction.date || Date.current).iso8601, class: "pure-input-1" %>
    <% end %>
  </div>

  <%# Description Column - Conditional display %>
  <div class="div-table-col">
    <% if transaction.persisted? %>
      <span data-transaction-row-target="description"><%= transaction.description %></span>
    <% else %>
      <%= f.text_field :description, class: "pure-input-1", data: { transaction_row_target: "description" } %>
    <% end %>
  </div>

  <%# Category Column - Use select %>
  <div class="div-table-col">
    <div class="category-select"> <%# Keep styling class if needed %>
      <%= f.select :category_id,
                   options_from_collection_for_select(categories, :id, :name, transaction.category_id),
                   { include_blank: true },
                   { class: "pure-input-1" } %>
    </div>
  </div>

  <%# Counterparty column.  A text field against a shared datalist rather than a select: there are hundreds
      of counterparties, and one select per row would put thousands of options on the page.  The error is
      marked on the field itself, never with a message below it, because transactions_list_controller
      measures one row's height and applies it to all of them.  The words go to `#transaction-message`
      above the list instead — see transactions/_message — because a coloured border and a tooltip alone
      read as a save that failed rather than a question waiting for an answer.

      A name no counterparty has comes back marked, with the name it would create carried in a hidden field.
      Saving again hands that name back and creates it; editing the field first makes the two disagree, so
      the new name is asked about in its turn rather than the old one being created behind the reader. %>
  <div class="div-table-col counterparty-cell">
    <% if transaction.counterparty_to_confirm %>
      <%= f.hidden_field :confirmed_counterparty_name, value: transaction.counterparty_to_confirm %>
    <% end %>
    <%= f.text_field :counterparty_name,
                     value: transaction.counterparty_name || transaction.counterparty&.name,
                     list: "counterparty-names",
                     class: "pure-input-1 #{counterparty_field_class(transaction)}",
                     title: transaction.errors[:counterparty_name].first,
                     data: { transaction_row_target: "counterparty" } %>
    <% if transaction.counterparty %>
      <%= link_to counterparty_path(transaction.counterparty),
                  class: "pure-button pure-button-small",
                  title: "Show #{transaction.counterparty.name}" do %>
        <span class="material-symbols-outlined">open_in_new</span>
      <% end %>
    <% elsif transaction.counterparty_to_confirm.nil? && transaction.description.present? %>
      <%# Copies the description across as a starting point for a counterparty name the reader can still
          adjust before saving — most descriptions ("TESCO STORES 2889") are close enough to be worth
          typing over rather than typing from scratch. %>
      <button type="button" class="pure-button pure-button-small"
              title="Copy description to counterparty"
              data-action="click->transaction-row#copyDescriptionToCounterparty">
        <span class="material-symbols-outlined">content_copy</span>
      </button>
    <% end %>
  </div>

  <%# Amount Column - Conditional display %>
  <div class="div-table-col currency <%= transaction.amount_pence&.positive? ? 'positive' : 'negative' %>">
    <% if transaction.persisted? %>
      <%# Display formatted amount if persisted %>
      <span><%= humanized_money_with_symbol transaction.amount %></span>
    <% else %>
      <%# Display number field if new %>
      <%= f.number_field :amount, step: "0.01", value: humanized_money(transaction.amount, symbol: false), class: "pure-input-1-2" %>
    <% end %>
  </div>

  <%# Balance Column - Display only %>
  <div class="div-table-col currency <%= transaction.balance_pence&.positive? ? 'positive' : 'negative' %>">
    <%= humanized_money_with_symbol transaction&.balance %>
  </div>

  <%# Actions Column - Use submit button and add delete button %>
  <div class="div-table-col actions-col"> <%# Added a class for potential styling %>
    <%# Shown by the transaction_row controller once the row has an edit to save.  Where a counterparty is
        waiting to be confirmed the button says so: the error itself can only be a tooltip on the field,
        and this is the control the reader has to press. %>
    <%= f.button type: :submit, class: "pure-button pure-button-primary pure-button-small save-button",
                 name: "save",
                 title: transaction.counterparty_to_confirm ?
                          "Create #{transaction.counterparty_to_confirm.inspect} and save" : "Save Transaction",
                 data: { transaction_row_target: "save" } do %>
      <span class="material-symbols-outlined">save</span>
    <% end %>

    <%# A rule made from the row the reader is looking at, rather than its description retyped on the rules
        screen.  The description and transaction type are spans on a persisted row, not fields, so they
        cannot be submitted — they travel in the query string instead and the rules form opens prefilled.

        A link and not a second submit button on this form: creating a rule can fail three ordinary ways —
        a duplicate description, a missing category, a pattern that will not compile — and a row that may
        not change its height has nowhere to report any of them.  The rules form is the review, and it
        arrives already filled in.  An <a> is not a member of form.elements either, so
        transaction_row_controller's field comparison never sees it, where a second submit would need the
        controller to branch on which button was pressed.

        Offered even where a rule already claims the row.  That reads wrong and is not: an exact rule for
        one particular charge that a broad pattern otherwise sweeps up is a documented thing to want, and
        hiding this on import_matcher_id would be the one way to make it impossible.  A description that
        already has a literal rule is refused by a uniqueness validation, on the form, where it can be read.

        Not offered while a counterparty is waiting to be confirmed: leaving the page would discard the
        confirmation, and the name it offered is not a record yet, so there is no counterparty to carry. %>
    <% if transaction.persisted? && transaction.description.present? && transaction.counterparty_to_confirm.nil? %>
      <%= link_to new_account_import_matcher_path(account, import_matcher: {
                    description: transaction.description,
                    category_id: transaction.category_id,
                    counterparty_id: transaction.counterparty_id }.compact),
                  class: "pure-button pure-button-small",
                  title: "Create an import rule from #{transaction.description.inspect}" do %>
        <span class="material-symbols-outlined">rule</span>
      <% end %>
    <% end %>

    <%# Delete link - Replaces button_to %>
    <% if transaction.persisted? %>
      <%= link_to account_transaction_path(account, transaction),
                  class: "pure-button pure-button-error pure-button-small",
                  title: "Delete Transaction",
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this transaction?" } do %>
        <span class="material-symbols-outlined">delete</span>
      <% end %>
    <% end %>
  </div>
<% end %> <%# End of form_with %>
