<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Our Accounts" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <%# Hidden while signed out.  Every item on it would bounce straight back to the sign-in screen, so
        the bar is noise on the only two screens a signed-out reader can see. %>
    <% if authenticated? %>
    <nav>
      <div class="pure-menu pure-menu-horizontal">
        <ul class="pure-menu-list">
          <li class="pure-menu-item">
            <%= link_to 'Accounts', accounts_path, class: "pure-menu-link" %>
          </li>
          <%# Second, next to Accounts: these two are the screens you come here to look at, and the three
              after them are how you configure what they show. %>
          <li class="pure-menu-item">
            <%= link_to 'Forecast', forecast_path, class: "pure-menu-link" %>
          </li>
          <li class="pure-menu-item">
            <%= link_to 'Categories', categories_path, class: "pure-menu-link" %>
          </li>
          <li class="pure-menu-item">
            <%= link_to 'Counterparties', counterparties_path, class: "pure-menu-link" %>
          </li>
          <li class="pure-menu-item">
            <%= link_to 'Input Columns Definition', import_columns_definitions_path, class: "pure-menu-link" %>
          </li>
          <%# Your own login, at the far end, away from the five screens the application is about.
              link_to with turbo_method rather than button_to: button_to would put a <form> inside the
              <li>, which Pure's horizontal menu lays out as though it were another item. %>
          <li class="pure-menu-item nav-end">
            <%= link_to Current.user.email_address, profile_path, class: "pure-menu-link" %>
          </li>
          <li class="pure-menu-item">
            <%= link_to 'Sign out', session_path, class: "pure-menu-link",
                        data: { turbo_method: :delete } %>
          </li>
        </ul>
      </div>
    </nav>
    <% end %>
    <div class="container">
      <%= yield %>
    </div>
  </body>
</html>
