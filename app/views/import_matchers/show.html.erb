<%= render "layouts/notice", notice: notice %>

<% content_for :title, "Rule for #{@account.name}" %>

<h1>Rule for <%= @account.name %></h1>

<%= show_actions back: account_import_matchers_path(@account),
                 edit: edit_account_import_matcher_path(@account, @import_matcher),
                 destroy: account_import_matcher_path(@account, @import_matcher),
                 confirm: "Destroy this rule? Transactions it already categorised keep their category." %>

<dl>
  <dt>Description</dt>
  <dd><%= @import_matcher.description %></dd>

  <dt>Matched</dt>
  <dd><%= @import_matcher.description_is_regex ? "as a pattern" : "exactly" %></dd>

  <dt>Transaction type</dt>
  <dd><%= @import_matcher.trx_type.presence || "any" %></dd>

  <dt>Category</dt>
  <dd><%= @import_matcher.category.name %></dd>

  <dt>Counterparty</dt>
  <dd>
    <% if @import_matcher.counterparty %>
      <%= link_to @import_matcher.counterparty.name, counterparty_path(@import_matcher.counterparty) %>
    <% else %>
      none
    <% end %>
  </dd>
</dl>

