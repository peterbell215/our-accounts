<%= render "layouts/notice", notice: notice %>

<% content_for :title, "Import rules for #{@account.name}" %>

<h1>Import rules for <%= @account.name %></h1>

<%# The only list in the application reached from somewhere other than the menu bar, so the only one with
    anywhere to go back to. %>
<%= form_actions back: account_path(@account) %>

<p>
  When a statement is imported, each transaction is checked against these rules.  The first rule whose
  description matches — and whose transaction type and amount match, if it names them — decides the
  transaction's category and counterparty.  An exact description is tried before a pattern, and a rule
  naming an amount is tried before one that does not, so a description can carry both a rule for one
  particular amount and a default for everything else.
</p>

<%= form_with url: account_import_matchers_path(@account), method: :get, local: true,
              html: { class: "pure-form", style: "margin-top: 1rem" } do |form| %>
  <%= form.search_field :q, value: params[:q], placeholder: "Filter by description",
                        class: "pure-input-1-3" %>
  <%= form.submit "Filter", class: "pure-button" %>
  <%= link_to "Clear", account_import_matchers_path(@account), class: "pure-button" if params[:q].present? %>
<% end %>

<p><%= pluralize(@import_matchers.size, "rule") %><%= " matching #{params[:q].inspect}" if params[:q].present? %>.</p>

<% if @import_matchers.any? %>
  <%# The scrolling box the transaction list uses: an account can carry a few hundred rules. %>
  <div class="transaction-scroll">
    <div class="div-table">
      <div class="div-table-header div-table-row">
        <div class="div-table-col header-col">Description</div>
        <div class="div-table-col header-col">Match</div>
        <div class="div-table-col header-col">Type</div>
        <div class="div-table-col header-col">Amount</div>
        <div class="div-table-col header-col">Category</div>
        <div class="div-table-col header-col">Counterparty</div>
        <div class="div-table-col header-col">Matched</div>
        <div class="div-table-col header-col">Actions</div>
      </div>

      <div class="div-table-body">
        <% @import_matchers.each do |import_matcher| %>
          <%= render "import_matchers/import_matcher", import_matcher: import_matcher,
                     account: @account, match_count: @match_counts[import_matcher.id] || 0 %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div style="margin-top: 1rem">
  <%= link_to "New rule", new_account_import_matcher_path(@account), class: "pure-button" %>
</div>
