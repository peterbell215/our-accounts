<p style="color: green"><%= notice %></p>

<% content_for :title, "Categories" %>

<h1>Categories</h1>

<p>Click a column heading to reorder the list, and again to reverse it.</p>

<table id="categories" class="pure-table pure-table-striped">
  <thead>
    <tr>
      <th><%= sort_link "name", "Name" %></th>
      <th><%= sort_link "description", "Description" %></th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr id="<%= dom_id category %>">
        <td><%= category.name %></td>
        <td><%= category.description %></td>
        <td><%= link_to "Show this category", category_path(category) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div style="margin-top: 1rem">
  <%= link_to "New category", new_category_path, class: "pure-button" %>
</div>
