<%= form_with(model: category, local: true, html: { class: "pure-form pure-form-aligned" }) do |form| %>
  <% if category.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(category.errors.count, "error") %> prohibited this category from being saved:</h2>
      <ul>
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset>
    <div class="pure-control-group">
      <%= form.label :name %>
      <%= form.text_field :name, class: "pure-input-1-3" %>
    </div>

    <div class="pure-control-group">
      <%= form.label :description %>
      <%= form.text_area :description, class: "pure-input-1-1" %>
    </div>

    <div class="pure-control-group">
      <%= form.label :forecast_method, "Predict this by" %>
      <%= form.select :forecast_method,
                      Category::FORECAST_METHOD_LABELS.map { |value, label| [ label, value ] },
                      {}, class: "pure-input-1-3" %>
      <%# The payments below are read from the category as it stands in the database, so choosing this
          method here does not conjure them: there is no JavaScript in this application to swap the
          section in as the select changes. %>
      <span class="pure-form-message-inline">
        Choosing <em>its regular payments</em> and saving adds a list of them to this screen, where each
        one's frequency can be corrected individually.
      </span>
    </div>

    <div class="pure-control-group">
      <%= form.label :forecast_months, "Months to average over" %>
      <%= form.number_field :forecast_months, min: 1, max: 24, placeholder: Category::DEFAULT_FORECAST_MONTHS,
                            class: "pure-input-1-3" %>
      <span class="pure-form-message-inline">
        Leave empty for <%= Category::DEFAULT_FORECAST_MONTHS %>.  Only used when predicting by average.
      </span>
    </div>

    <div class="pure-controls">
      <%= form.submit class: "pure-button pure-button-primary" %>
    </div>
  </fieldset>
<% end %>
