<%= render "layouts/notice", notice: notice %>

<% content_for :title, "Import columns for #{@import_columns_definition.account.name}" %>

<h1>Import columns for <%= @import_columns_definition.account.name %></h1>

<%= show_actions back: import_columns_definitions_path,
                 edit: edit_import_columns_definition_path(@import_columns_definition),
                 destroy: import_columns_definition_path(@import_columns_definition),
                 confirm: "Destroy this definition? Statements for #{@import_columns_definition.account.name} " \
                          "cannot be imported until another one describes their columns." %>

<%= render @import_columns_definition %>
