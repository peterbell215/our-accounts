<%= render "layouts/notice", notice: notice %>

<%= show_actions back: accounts_path, edit: edit_account_path(@account), destroy: account_path(@account),
                 confirm: "Destroy #{@account.name}? Its transactions, rules and import columns definition go with it." do %>
  <%= link_to "Manage Import Rules", account_import_matchers_path(@account), class: "pure-button" %>
<% end %>

<%= render 'accounts/account', account: @account %>

<h2>Transactions</h2>

<%# Adding a row acts on the list rather than on the account, so it stays with the list rather than
    joining the account's own actions at the top of the screen. %>
<%= link_to "Add New Transaction", new_account_transaction_path(@account), data: { turbo_stream: true }, class: "pure-button pure-button-primary" %>
<br><br> <%# Add some spacing %>

<%# Rendered once for the whole page, not per row and not in transactions/_rows: a second element with this
    id would arrive with every page the transactions_list controller fetches.  Rows fetched later resolve
    list="counterparty-names" against this one. %>
<datalist id="counterparty-names">
  <% @counterparties.each do |counterparty| %>
    <option value="<%= counterparty.name %>"></option>
  <% end %>
</datalist>

<% if @page.any? %>
  <%= render "transactions/navigation", account: @account, page: @page %>

  <%# The list scrolls within this box rather than with the page, because only a window of rows is ever
      in the document — page scrolling would have nothing to move. %>
  <div class="transaction-scroll"
       data-controller="transactions-list"
       data-transactions-list-size-value="<%= TransactionPage::SIZE %>"
       data-transactions-list-step-value="<%= TransactionPage::SIZE / 2 %>">
    <div id="trx-div-table" class="div-table">
      <%# Header Row %>
      <div class="div-table-header div-table-row">
        <div class="div-table-col header-col">Date</div>
        <div class="div-table-col header-col">Description</div>
        <div class="div-table-col header-col">Category</div>
        <div class="div-table-col header-col">Counterparty</div>
        <div class="div-table-col header-col">Amount</div>
        <div class="div-table-col header-col">Balance</div>
        <div class="div-table-col header-col">Actions</div>
      </div>

      <%# Body Rows.  Only the first page is rendered here; the transactions_list controller fetches
          further pages, keeps them in memory, and renders whichever window is in view. %>
      <div id="transactions_div_body" class="div-table-body">
        <% @page.transactions.each do |transaction| %>
          <%= render "transactions/transaction_as_row", transaction: transaction, categories: @categories, account: @account %>
        <% end %>
        <%= render "transactions/pager", account: @account, page: @page %>
      </div>
    </div>
  </div>
<% elsif @account.transactions.any? %>
  <%= render "transactions/navigation", account: @account, page: @page %>
  <p>No transactions on or before that date.</p>
<% else %>
  <p>No transactions found for this account.</p>
<% end %>
