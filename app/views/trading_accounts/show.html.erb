<%= render "layouts/notice", notice: notice %>

<%= render @trading_account %>

<div>
  <%= link_to "Edit this counterparty", edit_trading_account_path(@trading_account) %> |
  <%= link_to "Back to counterparties", trading_accounts_path %>

  <%= button_to "Destroy this counterparty", @trading_account, method: :delete,
                class: "pure-button",
                data: { turbo_confirm: "Delete #{@trading_account.name}? Its transactions are kept, but they will no longer name a counterparty." } %>
</div>

<h2>Transactions</h2>

<% if @transactions.any? %>
  <p>
    <%= pluralize(@transactions.size, "transaction") %>, totalling
    <strong><%= humanized_money_with_symbol @total %></strong>.
  </p>

  <table class="pure-table pure-table-striped" data-controller="dateinlocale">
    <thead>
      <tr>
        <th>Date</th>
        <th>Account</th>
        <th>Description</th>
        <th>Category</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      <% @transactions.each do |transaction| %>
        <tr id="<%= dom_id transaction %>">
          <td data-date="<%= transaction.date.iso8601 %>" data-dateinlocale-target="date">
            <%= transaction.date.strftime("%d/%m/%Y") %>
          </td>
          <td><%= link_to transaction.account.name, account_path(transaction.account) %></td>
          <td><%= transaction.description %></td>
          <td><%= transaction.category&.name %></td>
          <td class="currency <%= transaction.amount_pence&.positive? ? 'positive' : 'negative' %>">
            <%= humanized_money_with_symbol transaction.amount %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No transactions name this counterparty yet.</p>
<% end %>

<h2>Rules naming it</h2>

<% if @matchers.any? %>
  <table class="pure-table pure-table-striped">
    <thead>
      <tr>
        <th>Account</th>
        <th>Description</th>
        <th>Category</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @matchers.each do |matcher| %>
        <tr>
          <td><%= matcher.account.name %></td>
          <td><%= matcher.description %></td>
          <td><%= matcher.category.name %></td>
          <td><%= link_to "Edit", edit_account_import_matcher_path(matcher.account, matcher) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No import rule names this counterparty, so nothing will be linked to it automatically.</p>
<% end %>
