<%= form_with(model: trading_account, local: true, html: { class: "pure-form pure-form-aligned" }) do |form| %>
  <% if trading_account.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(trading_account.errors.count, "error") %> prohibited this counterparty from being saved:</h2>
      <ul>
        <% trading_account.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset>
    <div class="pure-control-group">
      <%= form.label :name %>
      <%= form.text_field :name, class: "pure-input-1-3" %>
      <span class="pure-form-message-inline">
        3 to 50 characters, and distinct from every other account name.
      </span>
    </div>

    <div class="pure-controls">
      <%= form.submit class: "pure-button pure-button-primary" %>
    </div>
  </fieldset>
<% end %>
