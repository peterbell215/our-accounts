<% content_for :title, "Set up two-factor authentication" %>

<h1>Set up two-factor authentication</h1>

<%= form_actions back: profile_path %>

<%= render "layouts/notice", notice: notice %>

<p>
  Scan this with an authenticator app — 1Password, Google Authenticator, Authy, whichever you use — then
  type the code it gives you, to prove it worked. Nothing changes about signing in until you do.
</p>

<div class="qr-code">
  <%= qr_code_svg(@user.provisioning_uri) %>
</div>

<p>
  If you cannot scan it, type this into the app by hand:
  <code><%= @user.otp_secret %></code>
</p>

<%= form_with url: totp_enrolment_path, class: "pure-form pure-form-aligned" do |form| %>
  <fieldset>
    <div class="pure-control-group">
      <%= form.label :otp_code, "Code from your app" %>
      <%= form.text_field :otp_code, required: true, autofocus: true, autocomplete: "one-time-code",
                          inputmode: "numeric", pattern: "[0-9]*", class: "pure-input-1-3" %>
    </div>

    <div class="pure-controls">
      <%= form.submit "Confirm", class: "pure-button pure-button-primary" %>
    </div>
  </fieldset>
<% end %>
