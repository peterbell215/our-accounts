<% content_for :title, "Sign in" %>

<h1>Sign in</h1>

<%# The layout does not render the flash — every screen renders it itself — and this one needs it more
    than most: a refused password says so here and nowhere else. %>
<%= render "layouts/notice", notice: notice %>

<%# No form_actions strip.  There is nowhere to go back to from here, which is the point of the screen. %>
<%= form_with url: session_path, class: "pure-form pure-form-aligned" do |form| %>
  <fieldset>
    <div class="pure-control-group">
      <%= form.label :email_address, "Email address" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                           value: params[:email_address], class: "pure-input-1-3" %>
    </div>

    <div class="pure-control-group">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "current-password",
                              class: "pure-input-1-3" %>
    </div>

    <div class="pure-controls">
      <%= form.submit "Sign in", class: "pure-button pure-button-primary" %>
    </div>
  </fieldset>
<% end %>
